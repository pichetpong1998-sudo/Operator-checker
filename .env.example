# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงก่อน deploy — ห้าม commit ไฟล์ .env เข้า version control
# ทุก secret ต้องสุ่มใหม่เอง ห้ามใช้ค่าตัวอย่างในระบบจริง

# ---------- PostgreSQL ----------
POSTGRES_USER=belt_check_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=belt_check_db

# ---------- JWT ----------
# สร้างด้วยคำสั่ง: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_64_CHAR_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- GPS / Geofence ----------
MAX_GPS_ACCURACY_M=35
PREFLIGHT_TOKEN_TTL_MIN=10

# ---------- MinIO (Object Storage) ----------
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=belt-inspection-photos

# ---------- Email (SMTP) — สำหรับแจ้งเตือน Critical Fail ----------
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USER=alerts@hongsa-mining.example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Belt Check Alert <alerts@hongsa-mining.example.com>"
ALERT_EMAIL_RECIPIENTS=engineer1@hongsa-mining.example.com,engineer2@hongsa-mining.example.com

# ---------- LINE Messaging API — สำหรับแจ้งเตือน Critical Fail ----------
LINE_CHANNEL_ACCESS_TOKEN=CHANGE_ME_LINE_CHANNEL_ACCESS_TOKEN
LINE_ALERT_GROUP_ID=CHANGE_ME_LINE_GROUP_OR_USER_ID

# ---------- CORS ----------
CORS_ORIGIN=https://belt-check.hongsa-mining.example.com
