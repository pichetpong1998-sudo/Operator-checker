# ใช้สำหรับรัน backend แบบ local (npm run dev) โดยไม่ผ่าน docker-compose
# สำหรับ production ใช้ .env ที่ root ร่วมกับ docker-compose.yml แทน

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://belt_check_app:CHANGE_ME@localhost:5432/belt_check_db

JWT_ACCESS_SECRET=CHANGE_ME_LOCAL_DEV_SECRET_AT_LEAST_16_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_LOCAL_DEV_SECRET_DIFFERENT_FROM_ACCESS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

REDIS_URL=redis://localhost:6379

MAX_GPS_ACCURACY_M=35
PREFLIGHT_TOKEN_TTL_MIN=10

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=belt-inspection-photos

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_RECIPIENTS=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALERT_GROUP_ID=

CORS_ORIGIN=*
